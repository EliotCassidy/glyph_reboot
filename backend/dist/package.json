{
  "name": "glyph-backend",
  "version": "0.2.4",
  "description": "NodeJS server for Glyph",
  "main": "./dist/index.js",
  "module": "./index.js",
  "keywords": [
    "api",
    "node"
  ],
  "homepage": "",
  "repository": "glyph-backend",
  "license": "SEE LICENSE IN LICENSE.txt",
  "author": {
    "name": "Sam A.",
    "email": "elimence@gmail.com"
  },
  "files": [
    "yarn.lock",
    "index.js",
    "config/!(local)*",
    "bin",
    "src",
    "data",
    "dist"
  ],
  "scripts": {
    "dev": "babel-watch --watch config ./bin | bunyan",
    "dev:inspect": "nodemon ./node_modules/.bin/babel-node --inspect bin",
    "prod": "nodemon ./dist/bin",
    "pretest": "gulp lint",
    "clean": "del dist",
    "prebuild": "yarn run clean",
    "build": "npm-run-all --parallel 'build:!(blueprint|docs|schemas)'",
    "build:index": "babel --source-maps --out-dir ./dist ./index.js",
    "build:src": "babel --source-maps --ignore='*.spec.js' --out-dir ./dist/src ./src",
    "build:bin": "babel --source-maps --out-dir ./dist/bin ./bin",
    "build:yarn_lock": "cpr yarn.lock dist/yarn.lock",
    "build:favicon": "cpr favicon.ico dist/favicon.ico",
    "build:config": "cpr config dist/config",
    "build:package_json": "cpr package.json dist/package.json",
    "dist": "yarn run build",
    "prepackage": "yarn run dist",
    "format": "standard --fix",
    "watch": "gulp watch"
  },
  "babel": {
    "plugins": [
      "transform-async-generator-functions",
      "transform-object-rest-spread"
    ],
    "presets": [
      [
        "env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ]
  },
  "engines": {
    "node": "^16.6.2"
  },
  "dependencies": {
    "@sendgrid/mail": "^7.4.6",
    "axios": "^0.21.1",
    "babel": "^6.23.0",
    "bluebird": "^3.5.1",
    "body-parser": "^1.18.2",
    "boom": "^7.3.0",
    "bunyan": "^1.8.12",
    "config": "^3.1.0",
    "cookie": "^0.4.1",
    "cors": "^2.8.5",
    "express": "^4.14.0",
    "express-jwt": "^6.0.0",
    "fast-csv": "^4.3.6",
    "helmet": "^3.15.0",
    "jwks-rsa": "^2.0.1",
    "moment": "^2.27.0",
    "mongo-dot-notation": "^2.0.0",
    "mongoose": "^5.12.3",
    "node-cache": "^5.1.2",
    "passport": "^0.4.1",
    "passport-local": "^1.0.0",
    "ramda": "^0.27.0",
    "request": "^2.85.0",
    "request-promise": "^4.2.6",
    "request-promise-native": "^1.0.3",
    "serve-favicon": "^2.5.0",
    "source-map-support": "^0.5.0",
    "sparkpost": "^2.1.4",
    "uuid": "^3.3.2",
    "validator": "^11.0.0"
  },
  "devDependencies": {
    "babel-cli": "^6.18.0",
    "babel-core": "^6.21.0",
    "babel-plugin-transform-async-generator-functions": "^6.24.1",
    "babel-plugin-transform-object-rest-spread": "^6.26.0",
    "babel-preset-env": "^1.1.4",
    "babel-watch": "^2.0.3",
    "cpr": "^3.0.1",
    "del-cli": "^1.0.0",
    "gulp": "^4.0.2",
    "gulp-cli": "^2.3.0",
    "gulp-jsonlint": "^1.1.2",
    "gulp-load-plugins": "^2.0.6",
    "gulp-plumber": "^1.1.0",
    "gulp-standard": "^10.0.0",
    "gulp-watch": "^5.0.1",
    "gulplog": "^1.0.0",
    "nodemon": "^1.11.0",
    "npm-run-all": "^4.0.0",
    "standard": "^10.0.1"
  }
}
